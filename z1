// Минуты
fun mi(m: Int): String {
    return when {
        m % 10 == 1 && m % 100 != 11 ->
            "$m минуту назад"
        m % 10 in 2..4 && m % 100 !in 12..14 ->
            "$m минуты назад"
        else -> "$m минут назад"
    }
}
// Часы
fun hs(h: Int): String {
    return when {
        h % 10 == 1 && h % 100 != 11 ->
            "$h час назад"
        h % 10 in 2..4 && h % 100 !in 12..14 ->
            "$h часа назад"
        else -> "$h часов назад"
    }
}

// Функция
fun fu(s: Int): String {
    return when (s) {
        in 0..60 -> "был(а) в сети только что"
        in 61..3600 -> mi(s / 60)
        in 3601..86400 -> hs(s / 3600)
        in 86401..172800 -> "был(а) в сети вчера"
        in 172801..259200 -> "был(а) в сети позавчера"
        else -> "был(а) в сети давно"
    }
}
